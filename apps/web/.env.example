# Copy to apps/web/.env and fill in. `bun env:production` / `bun env:preview`
# pushes this file's real counterpart to Vercel.

# Intake form → email. Required for the form on /#intake to send.
# Create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides. Defaults are team@dissonant.co and
# "Dissonant intake <intake@dissonant.co>". The from-address domain must be
# verified at https://resend.com/domains — until it is, use
# INTAKE_FROM_EMAIL="Dissonant intake <onboarding@resend.dev>", which only
# delivers to the Resend account owner.
# INTAKE_TO_EMAIL=team@dissonant.co
# INTAKE_FROM_EMAIL="Dissonant intake <intake@dissonant.co>"
